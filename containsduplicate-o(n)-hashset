class Solution {
public:
    bool containsDuplicate(vector<int>& nums) {


        unordered_set<int> seen; //unordered hash set

        for (int i = 0; i < nums.size(); i ++){  //setting up my hash set
            if (!seen.count(nums[i])){
                seen.insert(nums[i]);
            }
            else{
                return true; 
            }
        }

        return false;
       
    }
};
