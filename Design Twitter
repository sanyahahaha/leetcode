class Twitter {
public:

    unordered_map<int, vector<pair<int,int>>> tweets; //userID, tweetIDs 
    unordered_map<int, unordered_set<int>> fol; //what each person follows. set so it ignored duplicates  
    int time = 0;
    
   // priority_queue<pair<int,int>> q; //time, tweetId. max time at top  
    Twitter() {
        
    }
    
    void postTweet(int userId, int tweetId) { 
        time++; 
        tweets[userId].push_back({time, tweetId}); 
    
    }
    
    vector<int> getNewsFeed(int userId) {
        fol[userId].insert(userId); //each follower is a follower of itself z
        //i want to get the top 10 with the greatest time (as that shows the most recent, first)
        //do i add the values into a priority queue? 


        priority_queue<pair<int, int>, vector<pair<int,int>>, greater<pair<int,int>>> q; //time, tweetId - minHeap 
        //the priority queue should be made up of each person in fol[userid] (htier follopwers) stuff in tweets
        for (int f: fol[userId]){
            //given follower is f, i want to add their tweets into my queue
            for (auto t: tweets[f]){ //use auto instead of int because its a pair
                q.push({t.first, t.second}); 
            }
        }

        while (q.size() > 10){
            q.pop(); 

        }
        //my q is set, put it into a vector

        vector<int> ans;
        while (!q.empty()){
            int curr = q.top().second; 
            ans.push_back(curr);
            q.pop(); 
        }

        reverse(ans.begin(), ans.end()); 
        return ans; 


        
    }
    
    void follow(int followerId, int followeeId) {
        fol[followerId].insert(followeeId); 

    
    }
    
    void unfollow(int followerId, int followeeId) {
        fol[followerId].erase(followeeId); 
        
    }
};

