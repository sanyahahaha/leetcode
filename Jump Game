class Solution {
public:
    bool canJump(vector<int>& nums) {

        int goali = nums.size() - 1; 

        for (int i = nums.size() - 1; i >= 0; i--){
            if (nums[i] + i >= goali){ //its reachable 
                goali = i;



            }

        }


        if (goali == 0){
            return true;
        }
        return false; 
    }
};


