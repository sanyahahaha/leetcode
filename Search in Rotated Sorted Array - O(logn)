class Solution {
public:
    int search(vector<int>& nums, int target) {

        int left = 0;
        int right = nums.size() - 1;

        while (left <= right){
            int mid = (left + right ) / 2; 
        
            if ((left == right) && nums[left] != target){
                break;
            }
          //  cout << left << " " << right << " " << mid << " " << nums[mid] << endl;
            

            if (nums[mid] == target){ //target found
              // cout << "case1" << endl;
                return mid;
            }
            

            else if (nums[left] <= nums[mid]){ //properly soted on left
             //   cout << "case2: properly soted on left" << endl;
                if (target >= nums[left] && target <= nums[mid]){ //target is on left side, do binary search 
                right = mid - 1; 
                }
                else{ //target is on unsorted right side 
                    left = mid + 1; 
                }
            }

            else{ //properly soted on right
                //cout << "case3: properly soted on right" << endl;
                if (target >= nums[mid] && target <= nums[right]){
                    left = mid + 1; 
                }
                else{
                    right = mid - 1; 
                }
            }

        }


        
        return -1; 
    }
};
