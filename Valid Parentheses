class Solution {
public:
    bool isValid(string s) {

        stack<char> st; 

        for (char c: s){
            if (c == '(' || c == '{' || c == '['){ //its an opener so push
                st.push(c); 
            }
            else{
                 if (st.empty()){
            return false;
                 }

                if (c == ')' && st.top() == '('){
                    st.pop(); 
                }
                else if (c == ']' && st.top() == '['){
                    st.pop(); 
                }
                else if (c == '}' && st.top() == '{'){
                    st.pop(); 
                }
                else{
                    return false; 
                }
                
            }



        }
        if (st.empty()){
            return true;
        }
        return false; 


        
    }
};
