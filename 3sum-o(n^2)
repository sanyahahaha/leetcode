class Solution {
public:
    vector<vector<int>> threeSum(vector<int>& nums) {
        sort(nums.begin(), nums.end());


        vector<vector<int>> result; 
        for (int i = 0; i < nums.size(); i++){
            if (i > 0 && nums[i] == nums[i - 1]) continue; //skip dups
            int goaln =  nums[i] * -1;
           // cout << goaln << endl;
            int y;
            int z; 
            int left = i+1;
            int right = nums.size() - 1;
            while (left < right){
                if ((nums[left] + nums[right]) == goaln){ //triplet found
                //    result.push_back({nums[i], nums[left], nums[right]}); 
                 //   cout << "triplet for goal n: " << goaln << " at index " << i << " has been found" << nums[i] << " " << nums[left] << " " << nums[right] << endl;
                    result.push_back({nums[i], nums[left], nums[right]});
                    left++;
                    right--; 
                    while (left < right && nums[left] == nums[left - 1]) left++;   
                    while (left < right && nums[right] == nums[right + 1]) right--;
                    
                }
                else if ((nums[left] + nums[right]) > goaln){
                    right --;
                }
                else{
                    left++; 
                }
            }

        


        }


        

        return result; 
    }
};
