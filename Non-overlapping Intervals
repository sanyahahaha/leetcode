class Solution {
public:
    int eraseOverlapIntervals(vector<vector<int>>& intervals) {

        sort(intervals.begin(), intervals.end());


        vector<vector<int>> track; 
        int count = 0; 
        for (int i = 0; i < intervals.size(); i++){
            //cout << intervals[i][0] << " " << intervals[i][1] << endl; 
            if (track.empty() || intervals[i][0] >= track.back()[1]){
                track.push_back(intervals[i]); 

                  //cout << intervals[i][0] << " " << intervals[i][1] <<  " is chillll" << endl; 
            }
            else{ //it is overlapping
                count ++; 
                if (!(intervals[i][1] > track.back()[1])){ //remove track bc it has the bigger y val
                    track.pop_back();
                    track.push_back(intervals[i]); 

                }

            }

            
        }

       
        return count; 
    }
};
