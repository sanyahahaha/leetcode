class Solution {
public:
    void setZeroes(vector<vector<int>>& matrix) {

        int row = matrix.size();
        int col = matrix[0].size();

        vector<bool> rowC(row, false);
        vector<bool> colC(col, false); 

        for (int i = 0; i < row; i++){
            for (int j = 0; j < col; j++){
                if (matrix[i][j] == 0){
                    rowC[i] = true; //this row contains a zero
                    colC[j] = true; //thsis column contains a zero
                }


            }
        }


        for (int i = 0; i < row; i++ ){
            for (int j = 0; j < col; j++){
                if (rowC[i] == true || colC[j]== true){
                    matrix[i][j] = 0; 
                }


            }
        }


        
        
    }
};


