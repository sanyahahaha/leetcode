class KthLargest {
public:

    priority_queue<int, vector<int>, greater<int>> minH; 
    int k; //add function will also need k 
    KthLargest(int k, vector<int>& nums) { //the constructor... cannot return
        this->k = k; 
        int count = 0; 

        for (int num: nums){ //first add everything into a priority queue
            minH.push(num); 
            count ++; 
            if (count > k){
                minH.pop();     //now i want to pop the smallest values until the size of my queue is size k.
            }

        }




    }
    
    int add(int val) {

        minH.push(val);
        if (minH.size() > k){
             minH.pop();

        }
       
        return minH.top();
    }
};

