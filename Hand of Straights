class Solution {
public:
    bool isNStraightHand(vector<int>& hand, int groupSize) {

        if (hand.size() % groupSize != 0){
            return false; 
        }
        sort(hand.begin(), hand.end()); 

        map<int, int> freq; 

        for (int i = 0; i < hand.size(); i++){
            freq[hand[i]]++; 
        }

        for (auto& [x, c] : freq){
            while (freq[x] > 0){

                for (int count = 0; count < groupSize; count++){
                    int v = count + x;  //1, 2, 3 
                    if (freq.count(v) == 0 || freq[v] == 0){ //missing card. not gonna work 
                        return false; 

                    }
                    else{
                        freq[v] --; 
                    }
                    
                }
            }
            
        }

        return true;  
        
    }
};
