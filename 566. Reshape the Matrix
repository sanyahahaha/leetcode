class Solution {
public:
    vector<vector<int>> matrixReshape(vector<vector<int>>& mat, int r, int c) {
        
        int rows = mat.size();
        int cols = mat[0].size(); 
        int n = rows * cols; 

        vector<vector<int>> ans(r, vector<int>(c)); 


        int count = 0; 

        if ((r*c) == (rows * cols)){ //valid
            for (int i = 0; i < r; i++){
                for (int j = 0; j < c; j++){
                    ans[i][j] = mat[count/cols][count%cols];
                    count++; 

                }
            }
            return ans; 

        }

        return mat; 
        



    }
};
