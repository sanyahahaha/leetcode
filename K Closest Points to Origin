class Solution {
public:
    vector<vector<int>> kClosest(vector<vector<int>>& points, int k) {


      //  priority_queue<int, vector<int> greater<int>> minH; 
      priority_queue<pair<int, int>> maxH;  //i want to keep track of distance^2 and index of the point

    

        for (int i = 0; i < points.size(); i++){
            int x = points[i][0];
            int y = points[i][1]; 

            int dist = ((x * x) + (y * y)); //this is the distance squared 
            maxH.push({dist, i}); 

            if (maxH.size() > k){
                maxH.pop(); 
            }
        }

        vector<vector<int>> ans;

        while (!maxH.empty()){
            int index = maxH.top().second; 
            ans.push_back(points[index]); 
            maxH.pop(); 
        }


        return ans; 
        
    }
};
