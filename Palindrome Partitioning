class Solution {
public:
    vector<string> path;
    vector<vector<string>> ans; 

    void bt(string s, int i){
        if (i == s.size()){
            ans.push_back(path); 
        }
        if (i > s.size()){
            return; 
        }

        for (int end = i; end < s.size(); end++){ 
            string sub = s.substr(i, end - i + 1); 

            bool isPal = true; 
            int l = 0; 
            int r = sub.size() - 1; 
            
            while (l < r){
                if (sub[l] != sub[r]){
                    isPal = false; 
                }
                l++; 
                r--; 
            }
            
            if (isPal){
                path.push_back(sub); 
                 bt(s, end + 1); //go deeeper 
                 path.pop_back(); 
            }
        }
    

    }

    
    vector<vector<string>> partition(string s) {

        bt(s, 0); 
        

        return ans; 
    }
};
