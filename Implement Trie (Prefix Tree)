class Trie {
public:
    Trie* children[26]; 
    bool isEnd;     

    Trie() {
        for (int i = 0; i < 26; i++){
            children[i] = nullptr; 
        }
        isEnd = false; 
        
    }
    
    void insert(string word) {
        Trie* curr = this; //the node
        for (char c: word){
            int i = c - 'a'; //this is number 0-25
            if (curr->children[i] == nullptr){
                curr->children[i] = new Trie(); //creates a new pathway for this letter to be connected to more nodes 
            }
            curr = curr->children[i]; //curr was originally at the node. updating it for next  

        }
        curr->isEnd = true; //adds a pointer at the last letter saying this is where it ends

        
    }
    
    bool search(string word) {
        Trie* curr = this; //the node

        for (char c: word){
            int i = c - 'a'; //turns letter into index number 0-25
            if (curr->children[i] == nullptr){
                return false; 
            }
            curr = curr->children[i]; 
        }
        return curr->isEnd;  
        
    }
    
    bool startsWith(string prefix) {
        Trie* curr = this; 
        for (char c: prefix){
            int i = c - 'a'; 

            if (curr->children[i] == nullptr){
                return false; 
            }
            curr = curr->children[i]; 
        }

        return true; 
    }
};

