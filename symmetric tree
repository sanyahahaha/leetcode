/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */
class Solution {
public:

    bool isSame(TreeNode* leftv, TreeNode* rightv){
        if (leftv == nullptr && rightv == nullptr){
            return true; 
        }
        else if (leftv == nullptr || rightv == nullptr){
            return false; 
        }
        else if (leftv->val != rightv->val){
            return false; 
        }


        bool nextL = isSame(leftv->left, rightv->right);
        bool nextR = isSame(leftv->right, rightv->left);

        return (nextL && nextR); 


    }
    bool isSymmetric(TreeNode* root) {


        return isSame(root->left, root->right); 




        
    }
};
