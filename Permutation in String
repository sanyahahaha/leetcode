class Solution {
public:
    bool checkInclusion(string s1, string s2) {


        int left = 0;
        int count[26] = {0}; 

        int window[26] = {0}; 
        bool ans = false; 

        for (int i = 0; i < s1.size(); i++){
            count[s1[i] - 'a'] ++; 
        }

        for (int right = 0; right < s2.size(); right++){

            //put s2 char in window
            window[s2[right] - 'a'] ++; 
            if ((right - left + 1) > s1.size()){ //too big, remove left
                window[s2[left] - 'a'] --;
                left ++;
            }

            //checking if perm is good (count is equal to window)
            bool test = true; 
            for (int i = 0; i < 26; i++){
                if (count[i] != window[i]){
                    test = false;
                }
            }
            if (test){
                return true; 
            }
        }


        return ans; 
        
    }
};
