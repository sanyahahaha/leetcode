class Solution {
public:
    vector<vector<int>> merge(vector<vector<int>>& intervals) {

        vector<vector<int>> res; 

        sort(intervals.begin(), intervals.end()); 

        for (auto& cur: intervals){
            if (res.empty() || cur[0] > res.back()[1]){
                res.push_back(cur); 
            }
            else{
                res.back()[1] = max (res.back()[1], cur[1]); 
            }



        }

        return res;
        
    }
};
