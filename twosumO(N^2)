class Solution {
public:
    vector<int> twoSum(vector<int>& nums, int target) {

        vector<int> answerList; 

        for (int i= 0; i < nums.size(); i++){
            for (int j = 0; j < nums.size();j++){
                if (i != j){
                    if ((nums[i] + nums[j]) == target){
                        answerList.push_back(i);
                        answerList.push_back(j);
                        return answerList;
                    }
                }
                
            }
        }

        
            return answerList;          
        }
        
};
