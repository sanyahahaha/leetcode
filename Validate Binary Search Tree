/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */
class Solution {
public:
    bool checkV(TreeNode* root, long low, long high){

       
        if (root == nullptr){
            return true; 
        }
        else if (root->val <= low || root->val >= high){ //it is out of bounds
            return false; 
        }
  
        bool leftc = checkV(root->left, low,  root->val); 
        bool rightc = checkV(root->right,  root->val, high); 
        
        
        return (leftc && rightc); 

    }




    bool isValidBST(TreeNode* root) {
        

        return (checkV(root, LONG_MIN, LONG_MAX)); 
        
    }
};
