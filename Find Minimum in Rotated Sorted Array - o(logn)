class Solution {
public:
    int findMin(vector<int>& nums) {
      //  nums = {4,5,6,7,0,1, 2}; 
        int left = 0;
        int right = nums.size() - 1;
        int maxIndex =  nums.size() - 1; 
        int prev = -100; 

        while (left <= right){
            int mid = (left + right) /2 ; 

           if (mid - 1 < 0){
                prev = nums[nums.size() - 1]; 
            }
            else{
                prev = nums[mid - 1]; 
            }

    
          // cout << left << " " << right << " " << mid << " " << nums[mid] << " " << prev << endl; 
            if (prev > nums[mid]){ 
              //  cout << " case1    mid: " << mid << " valid at mid: " << nums[mid] << endl;
                return (nums[mid]); 
            }
            if (nums[mid] > nums[right] ){ //inflection is on left
               // cout << " case2    mid: " << mid << " valid at mid: " << nums[mid] << endl;
                left = mid + 1;
                
            }
            else{ //inflection on right
              //  cout << " case3    mid: " << mid << " valid at mid: " << nums[mid] << endl;
                right = mid - 1;  
            }


        }
        return nums[0]; 
    }


    
};
