class Solution {
public:
    int lengthOfLongestSubstring(string s) {

        vector<int> count(128, 0); //0-127 inclusive. set all values to 0

        int left = 0; 
        int ans = 0; 
        int a = 0; 

        for (int right = 0; right < s.size(); right++){
            //if the rule is broken, move left up. use while loop

            count[s[right]] ++; 
              a++;  
            while (count[s[right]] > 1){ //it is a repeated letter
                count[s[left]] --; 
                a--; 
                left ++; 
            }
          

            if (a > ans){
                ans = a; 
            }

        }

        return {ans}; 


        
    }
};
