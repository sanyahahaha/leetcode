class Solution {
public:
    int minEatingSpeed(vector<int>& piles, int h) {

        int leftk = 1;
        int rightk = *std::max_element(piles.begin(), piles.end());

        int minK = INT_MAX; 

      //  cout << leftk << rightk << endl;

        while (leftk <= rightk){
            long long hrC = 0; 
            int mid = (leftk + rightk) / 2; 

            for (int i = 0; i < piles.size(); i++){
                hrC += (piles[i] + mid - 1) / mid; 
            

            }   
         //   cout << " leftk " << leftk << " rightk: " << rightk << " mid (k):" << mid << " hrC: " << hrC << endl; 

            if (hrC > h){ //took too long, so make mid/k must be bigger. move left pointer up
                leftk = mid + 1;
             //   cout << "k is too small" << endl; 
            }
            else{
                minK = mid;
                 rightk = mid - 1;
          //       cout << "k MIGHT be too big" << endl; 
            }
         //   cout << " my min " << minK << endl; 

        }   
        


    return minK; 
    }
};
