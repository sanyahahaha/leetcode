class Solution {
public:
    int evalRPN(vector<string>& tokens) {

        stack<int> nums; 

        for (int i = 0; i < tokens.size(); i++){
            int calc; 
             if ((tokens[i] == "*" || tokens[i] == "/" || tokens[i] == "-" || tokens[i] == "+")){
                int val1 = nums.top(); 
                nums.pop(); 
                int val2 = nums.top(); 
                nums.pop(); 
                if (tokens[i] == "*"){
                    calc = val1 * val2; 
                }
                else if (tokens[i] == "/"){
                    calc = val2 / val1; 
                }
                else if (tokens[i]== "-" ){
                    calc = val2 - val1; 
                }
                else{
                    calc = val2 + val1; 
                }

                nums.push(calc); 

            }
            else{
               nums.push(stoi(tokens[i]));
            }
            
            
        }



        return nums.top(); 
    }   
};
