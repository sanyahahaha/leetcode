/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    ListNode* reverseList(ListNode* head) {

        ListNode* prev = nullptr; 
        ListNode* curr = head; 

        while (curr != nullptr){
            ListNode* nextNode = curr->next;  // save the next node
            curr->next = prev; //moving the curr to point to prev (switching direction of the arrow)
            prev = curr; //hprevious is now moved up to curr
            curr = nextNode; //curr is now moved up to nextNode 
        }


        return prev; 



        
    }
};
