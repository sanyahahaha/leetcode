class Solution {
public:
    bool mergeTriplets(vector<vector<int>>& triplets, vector<int>& target) {

        bool checka = false; 
        bool checkb = false; 
        bool checkc = false; 

        for (int i = 0; i < triplets.size(); i++){
            //check if its a safe triplet

            if ((triplets[i][0] <= target[0]) && (triplets[i][1] <= target[1]) && triplets[i][2] <= target[2] ){ //its a safe triplet
                if(triplets[i][0] == target[0]){
                    checka = true; 
                }
                if(triplets[i][1] == target[1]){
                    checkb = true; 
                }
                if(triplets[i][2] == target[2]){
                    checkc = true; 
                }

                
            }
        }


    

        return checka && checkb && checkc; 
        
    }
};
